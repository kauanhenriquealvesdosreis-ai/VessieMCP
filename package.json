{
  "name": "vessie-mcp",
  "version": "2.0.0",
  "description": "Servidor MCP profissional, modular e escalável com Clean Architecture",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "vessie-mcp": "./build/cli/index.js"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
    "watch": "tsc --watch",
    "start": "node build/index.js",
    "dev": "tsc --watch",
    "cli": "node build/cli/index.js",
    "test": "vitest",
    "test:unit": "vitest --config vitest.unit.config.ts",
    "test:integration": "vitest --config vitest.integration.config.ts",
    "test:e2e": "vitest --config vitest.e2e.config.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "db:generate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "docker:build": "docker build -t vessie-mcp .",
    "docker:start": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "health": "node build/cli/index.js health",
    "doctor": "node build/cli/index.js doctor"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "fastify": "^4.26.0",
    "@fastify/cors": "^8.5.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/jwt": "^7.2.4",
    "@fastify/redis": "^6.2.0",
    "@fastify/postgres": "^5.2.2",
    "@prisma/client": "^5.10.0",
    "ioredis": "^5.3.2",
    "pg": "^8.11.3",
    "zod": "^3.22.4",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^4.7.1",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.1",
    "dotenv": "^16.4.1",
    "joi": "^17.12.2",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-oauth2": "^1.8.0",
    "axios": "^1.6.7.0",
    "cheerio": "^1.0.0-rc.12",
